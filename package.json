{
  "name": "elushell",
  "version": "0.10.9",
  "private": true,
  "description": "EluShell SSH desktop workspace",
  "author": "EluShell",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "test": "vitest run",
    "test:desktop": "node scripts/management-smoke.mjs",
    "test:packaged": "node scripts/management-smoke.mjs --packaged",
    "test:portable": "node scripts/portable-check.mjs",
    "test:workspace": "node scripts/management-smoke.mjs",
    "format": "prettier --write src electron tests scripts",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis portable",
    "test:files": "node scripts/files-smoke.mjs",
    "test:appearance": "node scripts/appearance-smoke.mjs",
    "test:commands": "node scripts/commands-smoke.mjs",
    "test:newtab": "node scripts/newtab-smoke.mjs",
    "test:stress": "node scripts/stress-smoke.mjs",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 --x64",
    "prepare:mac": "npm run build && node scripts/prepare-mac.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/view": "6.43.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "dev.elushell.desktop",
    "productName": "EluShell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "EluShell-${version}-windows-${arch}.exe"
    },
    "nsis": {
      "artifactName": "EluShell-Setup-${version}-${arch}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "EluShell-${version}-macos-${arch}-preview.${ext}"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
